<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="azul">#1565C0</color>
    <color name="azul_oscuro">#0D47A1</color>
    <color name="verde">#2E7D32</color>
    <color name="rojo">#C62828</color>

    <style name="Tema.App" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorPrimaryDark">@color/azul_oscuro</item>
        <item name="colorAccent">@color/azul</item>
    </style>

    <style name="Tema.Escaner" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="colorAccent">@color/azul</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
